# Example Nginx config for xiaowangzi Web MVP on wan.lat.
# Copy to /etc/nginx/sites-available/xiaowangzi and symlink to sites-enabled.
# Replace certificate paths after issuing SSL certs with certbot or your chosen CA.

upstream xiaowangzi_next {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name wan.lat www.wan.lat;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://wan.lat$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wan.lat;

    ssl_certificate /etc/letsencrypt/live/wan.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wan.lat/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;

    access_log /var/log/nginx/xiaowangzi.access.log;
    error_log /var/log/nginx/xiaowangzi.error.log warn;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # BufPay callback endpoint must stay publicly reachable and must not be auth-gated by Nginx.
    location = /api/pay/notify {
        proxy_pass http://xiaowangzi_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / {
        proxy_pass http://xiaowangzi_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.wan.lat;

    ssl_certificate /etc/letsencrypt/live/wan.lat/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wan.lat/privkey.pem;

    return 301 https://wan.lat$request_uri;
}
